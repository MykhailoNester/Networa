# Copy to .env (gitignored) and adjust for your setup. All values are optional.

# Which SQLite database to use, resolved under ./data/ (default: networa.db,
# created on first run and excluded by .gitignore).
# Set DB_NAME=demo.db to browse the shipped sample data — but keep real holdings
# out of it, because demo.db is tracked in git.
DB_NAME=networa.db

# Optional: use an absolute path anywhere on disk (overrides DB_NAME).
# DATABASE_PATH=/absolute/path/to/mydata.db

# On first run against an *empty* database, seed a small illustrative portfolio
# so the dashboard is not blank. Never modifies a database that already has
# assets. Set to 0 to start completely empty.
# SEED_SAMPLE_DATA=0

# Web server bind address and port (defaults: 127.0.0.1:8000).
# Use 0.0.0.0 only behind a trusted reverse proxy — the app has no auth.
HOST=127.0.0.1
PORT=8000

# Extra HOSTNAMES the app should answer to, comma-separated. Any IP address
# (0.0.0.0, 127.0.0.1, 192.168.x.x, [::1], ...) and localhost always work, so
# you only need this when reaching the app by name — typically behind a reverse
# proxy. Restricting names is what stops DNS rebinding, where a hostile site
# points its own hostname at your loopback address; an IP literal cannot be
# repointed, which is why addresses need no allowlisting.
# Make sure the proxy forwards the original Host (nginx: `proxy_set_header Host $host`).
# Use "*" to turn the check off entirely.
# ALLOWED_HOSTS=networa.example.com
