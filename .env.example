# Copy to .env (gitignored) and adjust for your setup. All values are optional;
# the defaults below run the app on the shipped demo database.

# Which SQLite database to use, resolved under ./data/ (default: the demo DB).
# Point at your own filename to keep a private database, e.g. DB_NAME=mydata.db
DB_NAME=demo.db

# Optional: use an absolute path anywhere on disk (overrides DB_NAME).
# DATABASE_PATH=/absolute/path/to/mydata.db

# Web server bind address and port (defaults: 127.0.0.1:8000).
# Use 0.0.0.0 only behind a trusted reverse proxy — the app has no auth.
HOST=127.0.0.1
PORT=8000
